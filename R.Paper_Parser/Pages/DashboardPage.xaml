<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="R.Paper_Parser.DashboardPage"
             Title="Dashboard">

    <StackLayout Padding="20" Spacing="20">
        <Label Text="Welcome to your Dashboard!" FontSize="24" HorizontalOptions="Center" />

        <Button Text="Upload Research Paper" Clicked="OnUploadClicked"/>
        <Button Text="View My Summaries" Clicked="OnHistoryClicked"/>
        <Button Text="Upgrade to Premium" Clicked="OnUpgradeClicked"/>
        <Button Text="Logout" Clicked="OnLogoutClicked"/>
    </StackLayout>
</ContentPage>
