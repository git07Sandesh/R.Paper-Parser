<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="R.Paper_Parser.Pages.ForgotPassword"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

            <!-- Re:Parser Logo -->
            <Image Source="reparserimg.png"
                   HeightRequest="120"
                   HorizontalOptions="Center" />

            <!-- Prompt -->
            <Label Text="Write Your Email"
                   FontSize="18"
                   HorizontalOptions="Center"
                   TextColor="Black" />

            <!-- Email Entry -->
            <Border StrokeThickness="0"
                    BackgroundColor="#153B9F"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50">
                <Entry Placeholder="example@gmail.com"
                       BackgroundColor="Transparent"
                       TextColor="White"
                       PlaceholderColor="LightGray"
                       Keyboard="Email"
                       Margin="10,0" />
            </Border>

            <!-- SEND CODE Button -->
            <Button Text="SEND CODE"
                    FontSize="18"
                    TextColor="White"
                    BackgroundColor="#C5543B"
                    CornerRadius="10"
                    HeightRequest="55"
                    Clicked="OnSendCodeClicked" />

            <!-- Sign In Redirect -->
            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="Already have an account?"
                       FontSize="14"
                       TextColor="Black" />
                <Label Text=" Sign in"
                       FontSize="14"
                       TextColor="Red">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignInTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
