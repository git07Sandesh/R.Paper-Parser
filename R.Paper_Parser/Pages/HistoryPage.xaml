<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="R.Paper_Parser.Pages.HistoryPage"
             Title="Summary History">

    <ScrollView>
        <StackLayout Padding="20" Spacing="10">
            <Label Text="Previous Summaries" FontSize="24" HorizontalOptions="Center" />
            <CollectionView x:Name="HistoryList">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="Gray" Padding="10" Margin="5">
                            <StackLayout>
                                <Label Text="{Binding FileName}" FontAttributes="Bold"/>
                                <Label Text="{Binding Timestamp}" FontSize="12"/>
                                <Label Text="{Binding SummaryText}" LineBreakMode="TailTruncation" MaxLines="3"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ScrollView>
</ContentPage>
