<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="R.Paper_Parser.Pages.ResetPasswordPage"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

            <Label Text="Reset Password" FontSize="24" HorizontalTextAlignment="Center" />

            <!-- New Password -->
            <Entry x:Name="NewPasswordEntry" IsPassword="True" Placeholder="New Password" />

            <!-- Confirm Password -->
            <Entry x:Name="ConfirmPasswordEntry" IsPassword="True" Placeholder="Confirm Password" />

            <!-- Reset Button -->
            <Button Text="RESET PASSWORD" BackgroundColor="#153B9F" TextColor="White"
                    Clicked="OnResetPasswordClicked" />

            <!-- Back to Login -->
            <Button Text="BACK TO LOGIN" BackgroundColor="Transparent" TextColor="Black"
                    Clicked="OnBackToLoginClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
