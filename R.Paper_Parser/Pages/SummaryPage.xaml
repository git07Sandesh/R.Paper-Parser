<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="R.Paper_Parser.Pages.SummaryPage"
             Title="Summary">

    <ScrollView>
        <StackLayout Padding="20">
            <Label Text="Generated Summary" FontSize="24" HorizontalOptions="Center"/>
            <Label x:Name="SummaryLabel" FontSize="16" LineBreakMode="WordWrap"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
