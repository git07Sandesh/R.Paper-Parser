<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="R.Paper_Parser.Pages.SummaryPage"
             Title="Summary">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <!-- Header -->
        <StackLayout Grid.Row="0" Spacing="10">
            <Label Text="Generated Summary" FontSize="24" HorizontalOptions="Center"/>
            <Label x:Name="FileNameLabel" FontSize="16" HorizontalOptions="Center" TextColor="Gray"/>
        </StackLayout>
        
        <!-- Main content -->
        <ScrollView Grid.Row="1" Margin="0,10,0,10">
            <Border Stroke="LightGray" StrokeThickness="1" Padding="15" StrokeShape="RoundRectangle 10">
                <Label x:Name="SummaryLabel" FontSize="16" LineBreakMode="WordWrap"/>
            </Border>
        </ScrollView>
        
        <!-- Footer with action buttons -->
        <HorizontalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="Center">
            <Button Text="Share" Clicked="OnShareClicked" WidthRequest="100"/>
            <Button Text="Copy" Clicked="OnCopyClicked" WidthRequest="100"/>
            <!-- Premium feature button with overlay coming in Phase 5 -->
            <Button Text="Save as PDF (Coming in Phase 5)" Clicked="OnSaveAsPdfClicked" WidthRequest="180" IsEnabled="False"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
